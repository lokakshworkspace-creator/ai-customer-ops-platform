# Copy to .env and adjust. Never commit .env.
APP_ENV=dev                # dev | test | prod
LOG_LEVEL=INFO

# docker-compose reads these too
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ops

DATABASE_URL=postgresql+asyncpg://ops:ops@localhost:5432/ops
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth. The default below is for local dev only: the app refuses to start with it (or any
# secret shorter than 32 chars) unless APP_ENV=dev.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-do-not-use-outside-dev
JWT_EXPIRE_MINUTES=30
