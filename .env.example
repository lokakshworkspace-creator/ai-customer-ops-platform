# Copy to .env and adjust. Never commit .env.
APP_ENV=dev                # dev | test | prod
LOG_LEVEL=INFO

# docker-compose reads these too
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ops

DATABASE_URL=postgresql+asyncpg://ops:ops@localhost:5432/ops
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Phase 1 (auth) — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
