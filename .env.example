# Copy to .env and adjust. Never commit .env.
APP_ENV=dev                # dev | test | prod
LOG_LEVEL=INFO

# docker-compose reads these too
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ops

DATABASE_URL=postgresql+asyncpg://ops:ops@127.0.0.1:5432/ops
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Auth. The default below is for local dev only: the app refuses to start with it (or any
# secret shorter than 32 chars) unless APP_ENV=dev.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-do-not-use-outside-dev
JWT_EXPIRE_MINUTES=30

# The chat agent (Phase 3). LLM_PROVIDER=fake (the default) uses a built-in fake model: dev only,
# no key. To use Google Gemini set LLM_PROVIDER=gemini, put your key in GEMINI_API_KEY in .env ONLY
# (never in this file, never committed, never logged) and name a model in LLM_MODEL, for example
# one of Google's "flash-lite" models (see https://ai.google.dev/gemini-api/docs/models).
LLM_PROVIDER=fake
GEMINI_API_KEY=
LLM_MODEL=

# The knowledge base (Phase 4). EMBEDDING_PROVIDER=fake (the default) is a deterministic built-in
# embedder: dev and tests only. For real embeddings set EMBEDDING_PROVIDER=gemini and name a Gemini
# embedding model in EMBEDDING_MODEL (same GEMINI_API_KEY as above). The vector column is 768
# wide (EMBEDDING_DIM must stay 768 unless a new migration changes it).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
# EMBEDDING_DIM=768
# KB_NAMESPACE=default
# LLM_TIMEOUT_S=30
# LLM_MAX_TOKENS=1024
# LLM_HISTORY_MESSAGES=20

# Login rate limiting (Phase 6): failed logins per email + IP, counted in Redis. After
# LOGIN_MAX_FAILURES inside LOGIN_WINDOW_SECONDS the pair gets 429 + Retry-After. If Redis is down
# the limiter fails open (login keeps working). Behind the Next.js proxy (the dev setup) the API sees
# only the proxy, so set TRUSTED_PROXY_HOPS=1 there; leave it 0 when clients reach the API directly.
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# TRUSTED_PROXY_HOPS=0

# Approval expiry (Phase 6). THE SWEEPER MUST BE RUNNING (python -m app.jobs.sweeper) or approvals never
# expire. A decision after the deadline is refused either way. The limit is a setting, not a rule.
# APPROVAL_TTL_HOURS=48
# SWEEPER_INTERVAL_S=60
# SWEEPER_BATCH_SIZE=50
