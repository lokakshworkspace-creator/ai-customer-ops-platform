# Copy to .env and adjust. Never commit .env.
APP_ENV=dev                # dev | test | prod
LOG_LEVEL=INFO

# docker-compose reads these too
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ops

DATABASE_URL=postgresql+asyncpg://ops:ops@127.0.0.1:5432/ops
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Auth. The default below is for local dev only: the app refuses to start with it (or any
# secret shorter than 32 chars) unless APP_ENV=dev.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-do-not-use-outside-dev
JWT_EXPIRE_MINUTES=30

# The chat agent (Phase 3). Leave blank to use the built-in FAKE LLM (dev only). Put your key here
# in .env ONLY (never in this file, never committed, never logged). Model and limits are optional:
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT_S=30
# LLM_MAX_TOKENS=1024
# LLM_HISTORY_MESSAGES=20
